{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@componentes/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@estilos/*": ["src/styles/*"],
      "@datos/*": ["src/data/*"]
    }
  }
}
