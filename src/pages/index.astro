---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarruselBanners from '../components/home/CarruselBanners.astro';
import BuscadorTramites from '../components/home/BuscadorTramites.astro';
import RejillaRoles from '../components/home/RejillaRoles.astro';
import ComoFunciona from '../components/home/ComoFunciona.astro';
import CategoriasTramites from '../components/home/CategoriasTramites.astro';
import FechasClave from '../components/home/FechasClave.astro';
import PreguntasFrecuentes from '../components/home/PreguntasFrecuentes.astro';
import CifrasVerificadas from '../components/home/CifrasVerificadas.astro';
import CompromisoAccesible from '../components/home/CompromisoAccesible.astro';
import TarjetaTramite from '../components/base/TarjetaTramite.astro';
import Boton from '../components/base/Boton.astro';
import Icono from '../components/base/Icono.astro';
import { getCollection } from 'astro:content';
import {
  aIndexado,
  construirIndiceBusqueda,
  obtenerCategoriasConConteo,
  obtenerTramitesDestacados,
} from '../lib/tramites';

const indice = await construirIndiceBusqueda();
const destacados = (await obtenerTramitesDestacados()).map(aIndexado);
const categorias = await obtenerCategoriasConConteo();

/*
 * Cifras del bloque "Lo que se puede comprobar".
 *
 * REGLA: aquí no entra ningún número que no salga de una comprobación
 * reproducible. La tentación en un bloque así es poner estadísticas de la
 * dependencia —personas atendidas, trámites al año— y todas serían inventadas,
 * en un sitio que imita a una dependencia real. Estas cuatro se pueden auditar:
 * la primera se calcula aquí mismo desde la colección, y las otras tres las
 * imprime un comando.
 *
 * Si alguna deja de ser cierta, el comando lo dice. Actualizar entonces.
 */
const cifras = [
  {
    valor: indice.length,
    etiqueta: 'Trámites documentados',
    fuente: 'Calculado en build desde la colección de contenido.',
  },
  {
    valor: 76,
    etiqueta: 'Pares de color conformes con AA',
    fuente: '38 combinaciones × 2 temas · npm run a11y:contraste',
  },
  {
    valor: 100,
    sufijo: '/100',
    etiqueta: 'Accesibilidad en Lighthouse',
    fuente: 'En las cuatro plantillas del sitio · npm run lighthouse',
  },
  {
    valor: 0,
    etiqueta: 'Librerías de terceros en el navegador',
    fuente: 'Sin framework de UI ni librería de animación. Solo CSS y JS propio.',
  },
];

/* Los tres roles vienen del contenido; el cuarto acceso no es un rol sino una
   salida directa al listado, para quien ya sabe qué busca. */
const roles = [...(await getCollection('roles'))].sort((a, b) => a.data.orden - b.data.orden);

const accesos = [
  ...roles.map((rol) => ({
    href: `/perfil/${rol.data.clave}/`,
    etiqueta: rol.data.etiquetaHome,
    descripcion: rol.data.descripcionHome,
    icono: rol.data.icono,
  })),
  {
    href: '/tramites/',
    etiqueta: 'Busco un trámite',
    descripcion: 'Ver los trámites en una sola lista, con filtros por categoría.',
    icono: 'lupa' as const,
    destacado: true,
  },
];
---

<BaseLayout
  titulo="Inicio"
  descripcion="Trámites de personal de la UNAM organizados por quién eres: personal académico, personal administrativo y jefaturas de dependencia."
>
  <CarruselBanners />

  {
    /*
    El <h1> vive aquí y no en el carrusel a propósito: es la afirmación estable
    sobre el sitio. Dentro del carrusel sería un título que cambia cada 7
    segundos, o cuatro <h1> de los que tres están ocultos.
  */
  }
  <section class="portada">
    <div class="contenedor portada__contenido">
      <div class="portada__texto">
        <p class="portada__antetitulo">Dirección General de Personal</p>
        <h1 class="portada__titulo">Tus trámites de personal, sin adivinar a qué área le tocan</h1>
        <p class="portada__entradilla">
          Encuentra lo que necesitas por tu perfil o busca directamente el trámite. Sin recorrer el
          organigrama.
        </p>
      </div>

      <BuscadorTramites indice={indice} />
    </div>
  </section>

  <RejillaRoles accesos={accesos} titulo="Empieza por quién eres" />

  <section class="seccion seccion--sutil revelar" aria-labelledby="destacados">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <div>
          <h2 id="destacados">Los que más se consultan</h2>
          <p class="encabezado-seccion__nota">
            Cinco trámites concentran la mayoría de las visitas a esta dirección.
          </p>
        </div>
        <Boton href="/tramites/" variante="secundario">
          Ver los {indice.length} trámites
          <Icono nombre="flecha" tamano={1} />
        </Boton>
      </div>

      <ul class="rejilla lista-limpia revelar-hijos" role="list" style="--rejilla-min: 19rem;">
        {
          destacados.map((tramite) => (
            <li>
              <TarjetaTramite tramite={tramite} nivel={3} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ComoFunciona />

  <CategoriasTramites categorias={categorias} />

  <FechasClave />

  <PreguntasFrecuentes />

  <CifrasVerificadas cifras={cifras} />

  <CompromisoAccesible />

  <section class="seccion seccion--sutil revelar" aria-labelledby="que-cambia">
    <div class="contenedor contenedor--texto flujo flujo--amplio">
      <h2 id="que-cambia">Qué propone este prototipo</h2>

      <p>
        Este sitio es un ejercicio de rediseño, no el portal oficial. Se construyó para mostrar
        cuatro cambios concretos frente a la versión actual, y para poder discutirlos sobre algo
        navegable en lugar de sobre una lámina.
      </p>

      <ul class="propuestas lista-limpia" role="list">
        <li class="propuesta">
          <h3 class="propuesta__titulo">Navegación por rol, no por organigrama</h3>
          <p>
            Hoy hay que saber de qué subdirección depende un trámite antes de encontrarlo. Aquí la
            primera pregunta es quién eres, que sí sabes responder.
          </p>
        </li>
        <li class="propuesta">
          <h3 class="propuesta__titulo">Buscador que entiende cómo hablas</h3>
          <p>
            Cada trámite guarda los términos con los que la gente lo busca de verdad. Escribir
            &laquo;carta laboral&raquo; o &laquo;me incapacitaron&raquo; lleva al trámite correcto
            aunque no se llame así.
          </p>
        </li>
        <li class="propuesta">
          <h3 class="propuesta__titulo">Accesibilidad verificable</h3>
          <p>
            Contraste AA comprobado por script en los dos temas, navegación completa por teclado y
            control de tamaño de texto en el encabezado. Es una prueba que se puede volver a correr,
            no una declaración.
          </p>
        </li>
        <li class="propuesta">
          <h3 class="propuesta__titulo">Una sola identidad visual</h3>
          <p>
            Todo vive bajo el mismo dominio y el mismo sistema de diseño. Sin saltos a subdominios
            con otra apariencia a media ruta.
          </p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Banda de portada ------------------------------------------------ */

  .portada {
    background-color: var(--color-superficie-marca);
    color: var(--color-texto-sobre-marca);

    /* El buscador vive aquí dentro, sobre el azul: su anillo de foco necesita
       la variante clara o se queda en 1.2:1 contra el fondo. */
    --color-borde-foco: var(--color-borde-foco-sobre-marca);
  }

  .portada__contenido {
    display: flex;
    flex-direction: column;
    gap: var(--p-espacio-7);
    padding-block: var(--espacio-seccion);
  }

  .portada__texto {
    max-width: 40rem;
  }

  .portada__antetitulo {
    margin: 0 0 var(--p-espacio-2);
    color: var(--color-acento-fondo);
    font-size: var(--tipo-menudo-tamano);
    font-weight: var(--p-tipografia-peso-semi);
    letter-spacing: var(--p-tipografia-espaciado-amplio);
    text-transform: uppercase;
  }

  .portada__titulo {
    margin: 0;
    font-size: var(--tipo-hero-tamano);
    font-weight: var(--p-tipografia-peso-negrita);
    color: var(--color-texto-sobre-marca);
    text-wrap: balance;
  }

  .portada__entradilla {
    margin: var(--p-espacio-4) 0 0;
    font-size: var(--tipo-cuerpo-grande-tamano);
    color: var(--color-texto-tenue-sobre-marca);
    max-width: var(--contenedor-ancho-texto);
  }

  .encabezado-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--p-espacio-4);
    margin-block-end: var(--p-espacio-6);
  }

  .encabezado-seccion h2 {
    margin: 0;
    font-size: var(--tipo-titulo-1-tamano);
  }

  .encabezado-seccion__nota {
    margin: var(--p-espacio-2) 0 0;
    color: var(--color-texto-secundario);
  }

  .propuestas {
    display: grid;
    gap: var(--p-espacio-5);
    margin: 0;
  }

  .propuesta {
    padding-inline-start: var(--p-espacio-4);
    border-inline-start: var(--p-borde-grueso) solid var(--color-acento-linea);
  }

  .propuesta__titulo {
    margin: 0 0 var(--p-espacio-2);
    font-size: var(--tipo-titulo-3-tamano);
  }

  .propuesta p {
    margin: 0;
    color: var(--color-texto-secundario);
  }
</style>
