---
/**
 * Encabezado del sitio.
 *
 * Dos franjas:
 *   1. Barra de utilidades — controles de accesibilidad. Siempre visible,
 *      también en 375 px, con espacio propio para no competir con el logotipo.
 *   2. Franja principal — identidad y navegación.
 *
 * La navegación está organizada POR ROL, que es la corrección central frente
 * al sitio actual: primero se pregunta quién eres, no de qué subdirección
 * depende el trámite.
 */
import ControlTamanoTexto from '../a11y/ControlTamanoTexto.astro';
import ToggleTema from '../a11y/ToggleTema.astro';
import Icono from '../base/Icono.astro';

/*
 * Dos niveles de navegación, como en el sitio de la Facultad de Ingeniería:
 * las AUDIENCIAS arriba, en la barra fina, y los TEMAS en la navegación
 * principal. Allí son Alumnado / Profesorado / Exalumnos; aquí, los tres
 * perfiles de personal.
 *
 * El reparto no contradice la tesis del prototipo —empezar por quién eres—,
 * la refuerza: los perfiles quedan en el primer renglón de la página, la
 * navegación principal deja de mezclar temas con audiencias, y la rejilla
 * grande del inicio sigue llevando el peso del argumento.
 */
const PERFILES = [
  { href: '/perfil/academico/', texto: 'Personal académico' },
  { href: '/perfil/administrativo/', texto: 'Personal administrativo' },
  { href: '/perfil/jefe/', texto: 'Jefaturas' },
];

const ENLACES = [
  { href: '/', texto: 'Inicio' },
  { href: '/tramites/', texto: 'Trámites' },
  { href: '/cursos/', texto: 'Cursos' },
  { href: '/publicaciones/', texto: 'Publicaciones' },
];

/** Normaliza para comparar rutas con y sin barra final. */
const normalizar = (ruta: string) => (ruta.endsWith('/') ? ruta : `${ruta}/`);
const rutaActual = normalizar(Astro.url.pathname);

const esActual = (href: string) => rutaActual === normalizar(href);
/** Un enlace de sección se marca como "actual" también en sus páginas hijas. */
const enSeccion = (href: string) => rutaActual.startsWith(normalizar(href));
---

<header class="encabezado" id="dgpe-encabezado">
  <div class="utilidades">
    <div class="contenedor utilidades__fila">
      <!--
        Los perfiles ocupan aquí el lugar que en la Facultad de Ingeniería
        tienen Alumnado / Profesorado / Exalumnos: la primera línea de la
        página, antes que cualquier tema.

        Es un <nav> con su propio nombre para que no se confunda con la
        navegación principal al recorrer las regiones con lector de pantalla.
      -->
      <nav class="perfiles" aria-label="Entra por tu perfil">
        <ul class="perfiles__lista lista-limpia" role="list">
          {
            PERFILES.map(({ href, texto }) => (
              <li>
                <a
                  href={href}
                  class="perfiles__enlace"
                  aria-current={esActual(href) ? 'page' : undefined}
                >
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="utilidades__derecha">
        <p class="utilidades__aviso">
          <Icono nombre="aviso" tamano={1} />
          <span>Prototipo de rediseño &middot; datos de ejemplo</span>
        </p>

        <div class="utilidades__controles">
          <ControlTamanoTexto />
          <ToggleTema />
        </div>
      </div>
    </div>
  </div>

  <div class="encabezado__principal">
    <div class="contenedor encabezado__fila">
      <!--
        El escudo NO lleva aria-hidden: es parte del nombre accesible del
        enlace, que queda como "UNAM DGPE Dirección General de Personal".
        Ocultarlo y poner un aria-label en su lugar rompería el criterio 2.5.3
        (Label in Name), porque el nombre dejaría de contener el texto visible.
      -->
      <!-- En el inicio, este enlace lleva al inicio: se marca como actual para
           que no parezca que va a alguna parte. -->
      <a class="marca" href="/" aria-current={esActual('/') ? 'page' : undefined}>
        <span class="marca__escudo">UNAM</span>
        <span class="marca__texto">
          <span class="marca__sigla">DGPE</span>
          <span class="marca__nombre">Dirección General de Personal</span>
        </span>
      </a>

      <button
        id="dgpe-boton-menu"
        class="menu-boton"
        type="button"
        aria-expanded="false"
        aria-controls="dgpe-nav-principal"
      >
        <span class="menu-boton__barras" aria-hidden="true"></span>
        <span>Menú</span>
      </button>

      <nav id="dgpe-nav-principal" class="nav" aria-label="Navegación principal">
        <ul class="nav__lista lista-limpia" role="list">
          {
            ENLACES.map(({ href, texto }) => (
              <li>
                <a
                  href={href}
                  class="nav__enlace"
                  aria-current={esActual(href) ? 'page' : undefined}
                  data-en-seccion={enSeccion(href) ? 'true' : undefined}
                >
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  /*
   * Se reengancha en cada navegación (ver ToggleTema.astro para el porqué).
   *
   * Aquí el AbortController es imprescindible, no una comodidad: dos de los
   * listeners cuelgan de `document` y uno de `matchMedia`, y ninguno de los
   * tres se destruye al reemplazarse el DOM. Sin abortarlos, cada navegación
   * añadiría un manejador más de Escape y otro de clic-fuera, todos apuntando
   * a botones de páginas ya desaparecidas.
   */
  let controlador: AbortController | null = null;

  function iniciar() {
    controlador?.abort();
    controlador = new AbortController();
    const { signal } = controlador;

    const encabezado = document.getElementById('dgpe-encabezado');
    const boton = document.getElementById('dgpe-boton-menu');
    const nav = document.getElementById('dgpe-nav-principal');

    if (encabezado && boton && nav) {
      /*
       * Marca el encabezado como "con JavaScript". Hasta que esta línea corre,
       * el CSS mantiene la navegación SIEMPRE visible y el botón de menú oculto.
       *
       * Es lo contrario de lo habitual, y es deliberado: si el JavaScript no
       * carga, el menú plegado quedaría cerrado para siempre y el botón sería un
       * control muerto. Así, sin JS se ven todos los enlaces apilados —
       * menos elegante, pero utilizable.
       */
      /* La marca `data-js` ya la puso el <head> antes de pintar; ver la nota
         en el CSS de este componente. Aquí solo se enganchan los eventos. */

      const abierto = () => boton.getAttribute('aria-expanded') === 'true';

      const fijar = (valor: boolean) => {
        boton.setAttribute('aria-expanded', String(valor));
        nav.dataset.abierto = String(valor);
      };

      boton.addEventListener('click', () => fijar(!abierto()), { signal });

      /*
       * Escape cierra el menú y DEVUELVE EL FOCO al botón. Sin esa segunda parte
       * el foco se quedaría dentro de un menú ya invisible y la siguiente
       * pulsación de Tab llevaría a un lugar impredecible.
       */
      document.addEventListener(
        'keydown',
        (evento) => {
          if (evento.key === 'Escape' && abierto()) {
            fijar(false);
            boton.focus();
          }
        },
        { signal }
      );

      /* Un clic fuera cierra, pero sin robar el foco: quien usa ratón no lo espera. */
      document.addEventListener(
        'click',
        (evento) => {
          const destino = evento.target as Node;
          if (abierto() && !nav.contains(destino) && !boton.contains(destino)) {
            fijar(false);
          }
        },
        { signal }
      );

      /*
       * Al pasar a escritorio el menú siempre se ve, así que se reinicia el
       * estado. Si no, aria-expanded="true" quedaría mintiendo sobre un menú
       * que ya no es plegable.
       */
      const escritorio = window.matchMedia('(min-width: 48rem)');
      escritorio.addEventListener(
        'change',
        (e) => {
          if (e.matches) fijar(false);
        },
        { signal }
      );
    }
  }

  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .encabezado {
    background-color: var(--color-superficie-marca);
    color: var(--color-texto-sobre-marca);
    border-block-end: var(--p-borde-grueso) solid var(--color-acento-linea-sobre-marca);

    /*
     * El anillo de foco se redefine para todo lo que viva aquí dentro. El
     * valor global es azul.700, casi el mismo color que este fondo: daba
     * 1.2:1 y no se veía dónde estaba el foco al recorrer el menú.
     *
     * Se hace con la variable y no control por control porque las custom
     * properties heredan: cualquier control que se agregue después al
     * encabezado recibe el anillo correcto sin tocar nada.
     */
    --color-borde-foco: var(--color-borde-foco-sobre-marca);
  }

  /* ---------------------------------------------------------------- */
  /* Barra de utilidades                                               */
  /* ---------------------------------------------------------------- */

  .utilidades {
    border-block-end: var(--p-borde-fino) solid rgb(255 255 255 / 0.15); /* tokens-ok: separador translúcido sobre la marca. */
  }

  .utilidades__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--p-espacio-2);
    padding-block: var(--p-espacio-1);
  }

  /* --- Perfiles (la barra de audiencias) ---------------------------- */

  .perfiles__lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p-espacio-1) var(--p-espacio-4);
  }

  /*
   * En pantalla estrecha los tres perfiles se desplazan en una línea en vez de
   * apilarse en tres.
   *
   * Medido: envolviendo, la barra de utilidades pasaba a 152 px de alto a
   * 320 px de ancho —tres renglones—, un 27 % de la pantalla de un móvil
   * pequeño ocupado antes de ver nada de contenido.
   *
   * Se descartó la alternativa habitual, que es duplicar los enlaces dentro del
   * menú móvil: son tres anclas más en el documento con el mismo destino, y
   * este proyecto acaba de dedicar un PR a que ningún enlace lleve a donde ya
   * estás sin decirlo. Un desplazamiento horizontal no añade nada al DOM.
   *
   * No hace falta `tabindex` en el contenedor: lo que se desplaza son enlaces,
   * y al tabular el navegador los trae a la vista solo.
   */
  @media (max-width: 47.99rem) {
    /*
     * `min-width: 0` en los dos, y sin esto NADA de lo de abajo funciona: un
     * contenedor con `overflow-x` no se desplaza si puede crecer, y el valor
     * inicial de `min-width` en un elemento flex o de rejilla es `auto`, que
     * significa "no encojas por debajo de tu contenido". Medido sin ellos: la
     * lista media 384 px dentro de un viewport de 320, no se desplazaba, y
     * empujaba la página entera.
     *
     * Es la tercera vez que este mismo valor inicial causa un desbordamiento
     * en el proyecto —antes en los selectores del cotizador y en la rejilla de
     * las páginas de perfil—. Merece recordarse: al meter `overflow` o una
     * rejilla, `min-width: 0` casi nunca sobra.
     */
    .perfiles {
      min-width: 0;
    }

    .perfiles__lista {
      min-width: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      /* Que el último no quede pegado al borde al llegar al final. */
      padding-inline-end: var(--p-espacio-2);
    }

    .perfiles__enlace {
      white-space: nowrap;
    }
  }

  .perfiles__enlace {
    display: inline-flex;
    align-items: center;
    /* Alto táctil sin engordar la barra: el relleno vertical es mínimo y el
       objetivo se agranda con `min-height`, que no empuja a los vecinos. */
    min-height: var(--objetivo-tactil-min);
    padding-inline: var(--p-espacio-1);

    color: var(--color-texto-sobre-marca);
    font-size: var(--tipo-menudo-tamano);
    font-weight: var(--p-tipografia-peso-semi);
    text-decoration: none;
  }

  .perfiles__enlace:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* La página actual se marca con el filete de acento, no solo con
     aria-current: quien ve la pantalla también merece saber dónde está. */
  .perfiles__enlace[aria-current='page'] {
    box-shadow: inset 0 -2px 0 0 var(--color-acento-linea-sobre-marca);
  }

  .utilidades__derecha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p-espacio-2) var(--p-espacio-4);
  }

  .utilidades__aviso {
    display: inline-flex;
    align-items: center;
    gap: var(--p-espacio-2);
    margin: 0;
    color: var(--color-texto-tenue-sobre-marca);
    font-size: var(--tipo-menudo-tamano);
  }

  .utilidades__controles {
    display: flex;
    align-items: center;
    gap: var(--p-espacio-3);
    margin-inline-start: auto;
  }

  /*
   * En pantallas angostas el aviso compite por el espacio con los controles.
   * Se oculta VISUALMENTE, no con display:none, para que el lector de pantalla
   * siga anunciando que esto es un prototipo. Para quien ve, el aviso vuelve a
   * aparecer completo en el pie de página.
   */
  @media (max-width: 34rem) {
    .utilidades__aviso span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Franja principal                                                  */
  /* ---------------------------------------------------------------- */

  /*
   * En móvil sigue siendo una fila flexible que envuelve. A partir de 60rem
   * pasa a tres columnas para poder CENTRAR la navegación como hace la
   * Facultad de Ingeniería.
   *
   * Las columnas laterales son `1fr` y la del medio `auto`: así el centro es
   * el centro del contenedor y no el hueco que sobra entre el logotipo y el
   * borde. La tercera columna va vacía a propósito —es el precio de centrar
   * de verdad— y en móvil la ocupa el botón de menú.
   */
  .encabezado__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p-espacio-4);
    padding-block: var(--p-espacio-4);
  }

  @media (min-width: 60rem) {
    .encabezado__fila {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: var(--p-espacio-3);
    margin-inline-end: auto;
    color: var(--color-texto-sobre-marca);
    text-decoration: none;
  }

  .marca__escudo {
    display: grid;
    place-items: center;
    min-width: 3rem;
    padding: var(--p-espacio-2);
    border: var(--p-borde-medio) solid var(--color-acento-linea-sobre-marca);
    border-radius: var(--p-radio-sm);
    font-size: var(--tipo-menudo-tamano);
    font-weight: var(--p-tipografia-peso-negrita);
    letter-spacing: var(--p-tipografia-espaciado-amplio);
  }

  .marca__texto {
    display: flex;
    flex-direction: column;
  }

  .marca__sigla {
    font-size: var(--tipo-titulo-3-tamano);
    font-weight: var(--p-tipografia-peso-negrita);
    line-height: var(--p-tipografia-interlinea-apretada);
  }

  .marca__nombre {
    font-size: var(--tipo-menudo-tamano);
    color: var(--color-texto-tenue-sobre-marca);
  }

  .marca:hover .marca__sigla {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* ---------------------------------------------------------------- */
  /* Navegación                                                        */
  /* ---------------------------------------------------------------- */

  .menu-boton {
    display: inline-flex;
    align-items: center;
    gap: var(--p-espacio-2);

    min-height: var(--objetivo-tactil-min);
    padding-inline: var(--p-espacio-3);

    border: var(--p-borde-fino) solid var(--color-texto-tenue-sobre-marca);
    border-radius: var(--radio-control);
    color: var(--color-texto-sobre-marca);
    font-size: var(--tipo-menudo-tamano);
    font-weight: var(--p-tipografia-peso-semi);
  }

  .menu-boton__barras,
  .menu-boton__barras::before,
  .menu-boton__barras::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background-color: currentColor;
  }

  .menu-boton__barras {
    position: relative;
  }

  .menu-boton__barras::before,
  .menu-boton__barras::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .menu-boton__barras::before {
    inset-block-start: -0.35rem;
  }
  .menu-boton__barras::after {
    inset-block-start: 0.35rem;
  }

  .nav__lista {
    display: flex;
    flex-direction: column;
    gap: var(--p-espacio-1);
    margin: 0;
  }

  .nav__enlace {
    display: block;
    padding: var(--p-espacio-3);
    border-radius: var(--radio-control);
    color: var(--color-texto-sobre-marca);
    font-weight: var(--p-tipografia-peso-medio);
    text-decoration: none;
  }

  .nav__enlace:hover {
    background-color: rgb(255 255 255 / 0.12); /* tokens-ok: velo translúcido sobre la marca. */
    color: var(--color-texto-sobre-marca);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /*
   * La página actual se marca con aria-current="page" (para lector de pantalla)
   * Y con una barra de acento (para quien ve). Nunca solo con color.
   */
  .nav__enlace[data-en-seccion] {
    background-color: rgb(255 255 255 / 0.1); /* tokens-ok: velo translúcido sobre la marca. */
  }

  .nav__enlace[aria-current='page'] {
    font-weight: var(--p-tipografia-peso-negrita);
    box-shadow: inset 0 -3px 0 0 var(--color-acento-linea-sobre-marca);
  }

  /* --- Móvil -------------------------------------------------------- */

  @media (max-width: 47.99rem) {
    .nav {
      flex-basis: 100%;
      padding-block-end: var(--p-espacio-3);
    }

    /*
     * La marca es `data-js` en el <html>, no en el encabezado.
     *
     * Antes la ponía el script de este componente. Eso funcionaba, pero al
     * llegar las transiciones entre páginas el script pasó a correr en
     * `astro:page-load` — más tarde que antes, y ya después del primer
     * pintado. Con lo cual el encabezado se dibujaba con TODOS los enlaces
     * apilados y luego se encogía de golpe al aparecer el botón de menú,
     * empujando la página entera: 0.246 de Cumulative Layout Shift y 13
     * puntos de rendimiento.
     *
     * Ahora la marca la pone un script en línea del <head>, antes de pintar,
     * así que el navegador ya calcula el primer layout con el menú plegado y
     * no hay nada que corregir después.
     */

    /* Sin JavaScript el botón no sirve, así que no se muestra. */
    :root:not([data-js]) .menu-boton {
      display: none;
    }

    /* El menú solo se pliega cuando hay JavaScript para desplegarlo. */
    :root[data-js] .nav {
      display: none;
    }

    :root[data-js] .nav[data-abierto='true'] {
      display: block;
    }
  }

  /* --- Escritorio: menú siempre visible ---------------------------- */

  @media (min-width: 48rem) {
    .menu-boton {
      display: none;
    }

    .nav__lista {
      flex-direction: row;
      align-items: center;
      gap: var(--p-espacio-2);
    }
  }
</style>
