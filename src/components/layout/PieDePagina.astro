---
/**
 * Pie de página.
 *
 * Incluye los enlaces de transparencia y aviso de privacidad que un sitio
 * institucional necesita, y la declaración de accesibilidad — que la mayoría
 * de los sitios universitarios omite.
 */
import Icono from '../base/Icono.astro';

/* Misma normalización que en Encabezado.astro: compara rutas con y sin barra
   final para que "/tramites" y "/tramites/" cuenten como la misma página. */
const normalizar = (ruta: string) => (ruta.endsWith('/') ? ruta : `${ruta}/`);
const rutaActual = normalizar(Astro.url.pathname);
const esActual = (href: string) => rutaActual === normalizar(href);

const COLUMNAS = [
  {
    titulo: 'Por quién eres',
    enlaces: [
      { texto: 'Personal académico', href: '/perfil/academico/' },
      { texto: 'Personal administrativo', href: '/perfil/administrativo/' },
      { texto: 'Jefaturas de dependencia', href: '/perfil/jefe/' },
    ],
  },
  {
    titulo: 'Trámites',
    enlaces: [
      { texto: 'Todos los trámites', href: '/tramites/' },
      { texto: 'Circulares y avisos', href: '/publicaciones/' },
      { texto: 'Constancia de servicios', href: '/tramites/constancia-de-servicios/' },
      { texto: 'Alta ante el ISSSTE', href: '/tramites/alta-issste/' },
    ],
  },
  {
    titulo: 'Información',
    enlaces: [
      { texto: 'Aviso de privacidad', href: '/aviso-de-privacidad/' },
      { texto: 'Declaración de accesibilidad', href: '/accesibilidad/' },
      { texto: 'Transparencia', href: '/transparencia/' },
    ],
  },
];

/*
 * Fecha y versión SALEN DEL BUILD, no están escritas a mano.
 *
 * El pie de la DGPE muestra "Actualizado al 25 de agosto de 2026" y "Versión
 * 6.0.0.10.0.0.5". Copiar ese formato con números inventados sería fingir una
 * precisión que este prototipo no tiene: en cuanto la fecha se quedara vieja,
 * estaría mintiendo sin que nadie lo notara.
 *
 * Estos dos valores se calculan al compilar. La fecha es la de la compilación
 * real, y la "versión" es el commit del que salió, que Netlify expone en
 * COMMIT_REF. Cualquiera puede cotejar ese identificador contra el repositorio;
 * un "6.0.0.10.0.0.5" no se puede cotejar contra nada.
 *
 * En local no hay COMMIT_REF y se muestra "desarrollo", que es exactamente lo
 * que es.
 */
const construidoEl = new Date();
const fechaDeBuild = new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' }).format(construidoEl);
const version = process.env.COMMIT_REF?.slice(0, 7) ?? 'desarrollo';

const anio = construidoEl.getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__columnas">
      {
        COLUMNAS.map(({ titulo, enlaces }) => (
          <nav class="pie__columna" aria-label={titulo}>
            <h2 class="pie__titulo">{titulo}</h2>
            <ul class="lista-limpia" role="list">
              {enlaces.map(({ texto, href }) => (
                <li>
                  {/*
                    `aria-current` cuando el enlace apunta a la página en la
                    que ya estás. El encabezado ya lo hacía; el pie no, y eso
                    dejaba enlaces que se pulsan y no llevan a ninguna parte
                    sin ninguna señal de por qué. Con lector de pantalla se
                    anuncian igual que los demás, así que la única forma de
                    descubrirlo es pulsando y comprobando que nada cambió.
                  */}
                  <a href={href} aria-current={esActual(href) ? 'page' : undefined}>
                    {texto}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <!--
        Bloque legal y de identidad, a la derecha de los enlaces, como en el
        pie de la DGPE. Allí es donde viven la dirección, los términos de uso,
        la fecha de actualización y la versión.

        El aviso de prototipo va PRIMERO y no al final. En el pie original ese
        primer renglón es el de derechos reservados; aquí lo que más necesita
        leer alguien que llegue de rebote es que nada de esto tiene validez.
      -->
      <div class="pie__institucional">
        <p class="pie__sigla">DGPE</p>
        <p class="pie__nombre">Dirección General de Personal</p>

        <p class="pie__aviso">
          <strong>Este sitio es un prototipo.</strong> Se elaboró como propuesta de rediseño en el marco
          de un servicio social. Los trámites, plazos, costos y datos de contacto son ejemplos ilustrativos
          y <strong>no tienen validez oficial</strong>.
        </p>

        <p>
          Universidad Nacional Autónoma de México &middot; Ciudad Universitaria, Coyoacán, 04510,
          Ciudad de México.
        </p>

        <!--
          Buzón y teléfono de relleno, con TLD reservado por la RFC 2606 para
          que no puedan resolver a ninguna parte. Aquí estuvieron el conmutador
          y los correos REALES de la UNAM, en las 23 páginas: publicados en un
          prototipo con contenido ficticio, invitaban a contactar a la
          Universidad de verdad para preguntar por trámites inventados. Lo
          vigila `npm run check:ficticios`, que rompe el build si vuelven.
        -->
        <p class="pie__contacto">
          <Icono nombre="telefono" tamano={1} />
          <span>55 0000 0000 &middot; soporte@dgpe.example</span>
        </p>

        <p class="pie__meta">
          Compilado el {fechaDeBuild} &middot; versión <code>{version}</code><br />
          Hecho en la UNAM &middot; {anio}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .pie {
    margin-block-start: var(--espacio-seccion);
    padding-block: var(--espacio-seccion);
    background-color: var(--color-superficie-marca);
    color: var(--color-texto-sobre-marca);
    border-block-start: var(--p-borde-grueso) solid var(--color-acento-linea-sobre-marca);

    /* Mismo motivo que en el encabezado: sobre este azul el anillo de foco
       por defecto se queda en 1.2:1. Aquí afectaba a los nueve enlaces. */
    --color-borde-foco: var(--color-borde-foco-sobre-marca);
  }

  /*
   * Enlaces a la izquierda y bloque institucional a la derecha, como en el pie
   * de la DGPE. La última columna es más ancha porque lleva prosa, no una
   * lista: con el mismo ancho que las otras tres el texto legal quedaba en
   * renglones de cuatro palabras.
   *
   * En móvil se apila todo en una sola columna, con el bloque institucional al
   * final: quien recorre el pie con el pulgar busca enlaces, no la versión del
   * build.
   */
  .pie__columnas {
    display: grid;
    gap: var(--p-espacio-7);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .pie__columnas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .pie__columnas {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.7fr);
    }
  }

  .pie__sigla {
    margin: 0;
    font-size: var(--tipo-titulo-2-tamano);
    font-weight: var(--p-tipografia-peso-negrita);
    line-height: var(--p-tipografia-interlinea-apretada);
  }

  .pie__nombre {
    margin: 0 0 var(--p-espacio-4);
    font-weight: var(--p-tipografia-peso-semi);
  }

  /* --- Bloque institucional ------------------------------------------ */

  .pie__institucional p {
    margin: 0 0 var(--p-espacio-3);
    color: var(--color-texto-tenue-sobre-marca);
    font-size: var(--tipo-menudo-tamano);
  }

  .pie__institucional strong {
    color: var(--color-texto-sobre-marca);
  }

  .pie__aviso {
    padding-inline-start: var(--p-espacio-4);
    /* Filete de acento en el borde: distingue el aviso del resto del bloque
       sin necesidad de un fondo, que sobre la marca se vería como un parche. */
    border-inline-start: var(--p-borde-grueso) solid var(--color-acento-linea-sobre-marca);
  }

  .pie__contacto {
    display: flex;
    align-items: center;
    gap: var(--p-espacio-2);
  }

  .pie__meta code {
    /* Sin fondo ni caja: es un identificador, no un bloque de código. La
       tipografía monoespaciada basta para que se lea como algo que se copia.
       El token existe, así que no hace falta respaldo. */
    font-family: var(--p-tipografia-familia-mono);
  }

  .pie__titulo {
    margin: 0 0 var(--p-espacio-3);
    font-size: var(--tipo-titulo-4-tamano);
    color: var(--color-texto-sobre-marca);
  }

  .pie__columna ul {
    display: flex;
    flex-direction: column;
    gap: var(--p-espacio-2);
    margin: 0;
  }

  /*
   * Los topos de los enlaces, como en el pie de la DGPE.
   *
   * Se dibujan con CSS y no con un carácter de texto por el mismo motivo que
   * los separadores de las migas: un lector de pantalla leería "círculo" o
   * "punto" antes de cada uno de los nueve enlaces. Al ser un ::before
   * decorativo no existe para el árbol de accesibilidad.
   */
  .pie__columna li {
    display: flex;
    align-items: baseline;
    gap: var(--p-espacio-3);
  }

  .pie__columna li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border: var(--p-borde-medio) solid var(--color-acento-linea-sobre-marca);
    border-radius: var(--radio-pastilla);
  }

  .pie a {
    color: var(--color-texto-sobre-marca);
    font-size: var(--tipo-menudo-tamano);
    /* Sobre fondo de marca el subrayado es la única señal de enlace que
       sobrevive: aquí no hay diferencia de color contra el texto normal. */
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pie a:hover {
    color: var(--color-acento-fondo);
    text-decoration-thickness: 2px;
  }

  .pie__meta {
    margin-block: var(--p-espacio-5) 0;
    padding-block-start: var(--p-espacio-4);
    border-block-start: var(--p-borde-fino) solid rgb(255 255 255 / 0.2); /* tokens-ok: separador translúcido sobre la marca. */
  }
</style>
