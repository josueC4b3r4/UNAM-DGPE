---
/**
 * Etiqueta compacta para metadatos: categoría, modalidad, duración.
 *
 * Es puramente informativa — nunca interactiva. Si necesitas un filtro
 * clicable, usa un <button> o un <a> real, no esto con un onclick encima.
 */
import Icono from './Icono.astro';
import type { NombreIcono } from './iconos';

interface Props {
  icono?: NombreIcono;
  /** Contexto que el lector de pantalla necesita y el diseño no muestra. */
  contexto?: string;
  tono?: 'neutro' | 'marca' | 'acento';
  class?: string;
}

const { icono, contexto, tono = 'neutro', class: clase } = Astro.props;
---

<span class:list={['pastilla', `pastilla--${tono}`, clase]}>
  {icono && <Icono nombre={icono} tamano={0.95} />}
  {contexto && <span class="visualmente-oculto">{contexto}: </span>}
  <slot />
</span>

<style>
  .pastilla {
    display: inline-flex;
    align-items: center;
    gap: var(--p-espacio-1);

    padding: var(--p-espacio-1) var(--p-espacio-3);
    border: var(--p-borde-fino) solid var(--color-borde-sutil);
    border-radius: var(--radio-pastilla);

    font-size: var(--tipo-menudo-tamano);
    line-height: var(--p-tipografia-interlinea-apretada);

    /*
     * Antes era `white-space: nowrap`, y medido desbordaba: "Categoría:
     * Prestaciones y seguridad social" mide 269 px dentro de un contenedor de
     * 199 cuando se juntan 320 px de ancho y el tamaño de texto "Muy grande".
     * Al no poder partir, empujaba la página entera y obligaba a desplazarse
     * en horizontal — incumpliendo el criterio 1.4.10 de WCAG 2.1.
     *
     * `balance` reparte las líneas de forma pareja en vez de dejar una palabra
     * suelta abajo, así que la pastilla sigue leyéndose como una etiqueta y no
     * como un párrafo. Con etiquetas cortas —la mayoría— nunca parte, y el
     * aspecto es exactamente el de antes.
     */
    text-wrap: balance;
  }

  .pastilla--neutro {
    background-color: var(--color-superficie-sutil);
    color: var(--color-texto-secundario);
  }

  .pastilla--marca {
    background-color: var(--color-superficie-marca-sutil);
    border-color: var(--color-accion-secundaria-borde);
    color: var(--color-accion-secundaria-texto);
  }

  .pastilla--acento {
    background-color: var(--color-acento-fondo);
    border-color: var(--color-acento-linea);
    color: var(--color-acento-texto);
  }
</style>
