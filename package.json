{
  "name": "dgpe-prototipo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototipo de rediseño del sitio de la Dirección General de Personal (DGPE) — UNAM. Navegación por rol, buscador de trámites y sistema de diseño accesible.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "npm run tokens && astro dev",
    "start": "npm run dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "node scripts/build-tokens.mjs",
    "test": "node scripts/test-busqueda.mjs",
    "check": "astro check",
    "a11y:contraste": "node scripts/check-contraste.mjs",
    "a11y:tokens": "node scripts/check-hardcoded.mjs",
    "verificar": "npm run tokens && npm run test && npm run a11y:contraste && npm run a11y:tokens && npm run check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,css,md}\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@eslint/js": "^9.37.0",
    "@fontsource-variable/source-sans-3": "^5.2.5",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
