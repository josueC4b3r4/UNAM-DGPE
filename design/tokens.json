{
  "$description": "Sistema de diseño DGPE — fuente de verdad. Formato W3C DTCG, compatible con Tokens Studio for Figma. Editar aquí y correr `npm run tokens` para regenerar src/styles/tokens/*.css. NUNCA editar el CSS generado.",

  "primitivo": {
    "$description": "Capa 1: la paleta cruda. Valores literales, sin significado de uso. Nadie debe consumir estos tokens directamente desde un componente — se consumen a través de la capa semántica.",

    "color": {
      "$type": "color",

      "azul": {
        "$description": "Azul institucional UNAM. El 600 es el tono de marca; el resto es la escala derivada.",
        "50": { "$value": "#edf4fb" },
        "100": { "$value": "#d6e6f6" },
        "200": { "$value": "#aeccec" },
        "300": { "$value": "#7cacde" },
        "400": { "$value": "#4a87c7" },
        "500": { "$value": "#2668a8" },
        "600": { "$value": "#14528a" },
        "700": { "$value": "#0c4270" },
        "800": { "$value": "#093155" },
        "900": { "$value": "#06213a" },
        "950": { "$value": "#041524" }
      },

      "oro": {
        "$description": "Oro de la Gaceta UNAM. Color de acento — se usa con moderación, nunca como fondo de texto largo.",
        "50": { "$value": "#fcf7e8" },
        "100": { "$value": "#f8edc6" },
        "200": { "$value": "#f0d98a" },
        "300": { "$value": "#e3c04b" },
        "400": { "$value": "#cfa524" },
        "500": { "$value": "#ac8617" },
        "600": { "$value": "#8b6b11" },
        "700": { "$value": "#6a510d" },
        "800": { "$value": "#493809" },
        "900": { "$value": "#2c2105" }
      },

      "neutro": {
        "$description": "Grises con un ligero sesgo azul para que convivan con el azul institucional sin verse sucios.",
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#f7f8fa" },
        "100": { "$value": "#eef0f4" },
        "200": { "$value": "#e0e4ea" },
        "300": { "$value": "#c6cdd7" },
        "400": { "$value": "#98a2b0" },
        "500": { "$value": "#6c7787" },
        "600": { "$value": "#515c6b" },
        "700": { "$value": "#3b4552" },
        "800": { "$value": "#29313b" },
        "900": { "$value": "#1a1f27" },
        "950": { "$value": "#0f1319" },
        "1000": { "$value": "#000000" }
      },

      "exito": {
        "50": { "$value": "#e9f7ef" },
        "100": { "$value": "#c7ead6" },
        "300": { "$value": "#5fbc89" },
        "600": { "$value": "#1a6b41" },
        "700": { "$value": "#125231" },
        "900": { "$value": "#0a2c1b" }
      },

      "alerta": {
        "50": { "$value": "#fdf3e3" },
        "100": { "$value": "#f9e2bc" },
        "300": { "$value": "#d8a23f" },
        "600": { "$value": "#8a5a0b" },
        "700": { "$value": "#6b4508" },
        "900": { "$value": "#3a2504" }
      },

      "error": {
        "50": { "$value": "#fdeceb" },
        "100": { "$value": "#f9cdca" },
        "300": { "$value": "#e8756c" },
        "600": { "$value": "#a12119" },
        "700": { "$value": "#7f1a13" },
        "900": { "$value": "#450e0a" }
      }
    },

    "espacio": {
      "$description": "Escala de 4 px (0.25rem). Usar solo estos pasos — nada de márgenes arbitrarios.",
      "$type": "dimension",
      "0": { "$value": "0" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.5rem" },
      "6": { "$value": "2rem" },
      "7": { "$value": "2.5rem" },
      "8": { "$value": "3rem" },
      "9": { "$value": "4rem" },
      "10": { "$value": "5rem" },
      "11": { "$value": "6rem" },
      "12": { "$value": "8rem" }
    },

    "tipografia": {
      "familia": {
        "$type": "fontFamily",
        "base": {
          "$value": "'Source Sans 3 Variable', 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "$description": "Source Sans 3 tiene formas abiertas y buena distinción entre I/l/1, lo que ayuda a lectores con baja visión. Se autohospeda: no hay petición a un CDN externo."
        },
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, 'Cascadia Mono', 'Segoe UI Mono', Menlo, Consolas, monospace"
        }
      },

      "tamano": {
        "$type": "dimension",
        "$description": "Escala modular ~1.2. Todo en rem para que el control de tamaño de texto del header y el zoom del navegador funcionen.",
        "100": { "$value": "0.75rem" },
        "200": { "$value": "0.875rem" },
        "300": { "$value": "1rem" },
        "400": { "$value": "1.125rem" },
        "500": { "$value": "1.25rem" },
        "600": { "$value": "1.5rem" },
        "700": { "$value": "1.875rem" },
        "800": { "$value": "2.25rem" },
        "900": { "$value": "3rem" }
      },

      "tamanoFluido": {
        "$type": "string",
        "$description": "DTCG no tiene un primitivo para clamp(), así que estos van como string. Escalan con el viewport sin media queries.",
        "titulo": { "$value": "clamp(1.5rem, 1.15rem + 1.75vw, 2.25rem)" },
        "hero": { "$value": "clamp(2rem, 1.3rem + 3.4vw, 3rem)" }
      },

      "peso": {
        "$type": "fontWeight",
        "normal": { "$value": "400" },
        "medio": { "$value": "500" },
        "semi": { "$value": "600" },
        "negrita": { "$value": "700" }
      },

      "interlinea": {
        "$type": "number",
        "$description": "WCAG 1.4.12 pide que el texto siga siendo legible con interlineado de 1.5. El cuerpo ya nace en 1.6.",
        "apretada": { "$value": "1.15" },
        "titulo": { "$value": "1.25" },
        "normal": { "$value": "1.5" },
        "comoda": { "$value": "1.65" }
      },

      "espaciado": {
        "$type": "dimension",
        "titulo": { "$value": "-0.015em" },
        "normal": { "$value": "0" },
        "amplio": { "$value": "0.04em" }
      }
    },

    "radio": {
      "$type": "dimension",
      "none": { "$value": "0" },
      "sm": { "$value": "0.25rem" },
      "md": { "$value": "0.5rem" },
      "lg": { "$value": "0.75rem" },
      "xl": { "$value": "1rem" },
      "completo": { "$value": "999rem" }
    },

    "borde": {
      "$type": "dimension",
      "fino": { "$value": "1px" },
      "medio": { "$value": "2px" },
      "grueso": { "$value": "3px" }
    },

    "movimiento": {
      "duracion": {
        "$type": "duration",
        "instantanea": { "$value": "0ms" },
        "rapida": { "$value": "150ms" },
        "media": { "$value": "250ms" },
        "lenta": { "$value": "400ms" }
      },
      "curva": {
        "$type": "cubicBezier",
        "salida": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
        "entrada": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
        "suave": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" }
      }
    },

    "capa": {
      "$type": "number",
      "base": { "$value": "0" },
      "elevada": { "$value": "10" },
      "pegajosa": { "$value": "100" },
      "encabezado": { "$value": "200" },
      "menu": { "$value": "300" },
      "modal": { "$value": "400" },
      "saltar": { "$value": "500" }
    }
  },

  "semantico": {
    "$description": "Capa 2: intención de uso. Esto es lo que consumen los componentes. Cambiar la marca = reapuntar estos alias, sin tocar un solo componente.",

    "comun": {
      "$description": "Tokens que no dependen del tema claro/oscuro.",

      "contenedor": {
        "$type": "dimension",
        "ancho": { "$value": "75rem", "$description": "Ancho máximo del contenido general." },
        "anchoTexto": {
          "$value": "44rem",
          "$description": "Ancho máximo de párrafos largos (~70 caracteres). WCAG 1.4.8 sugiere no pasar de 80."
        },
        "margen": {
          "$type": "string",
          "$value": "clamp(1rem, 5vw, 2.5rem)",
          "$description": "Respiro lateral. En 375 px da 1rem; en escritorio, 2.5rem."
        }
      },

      "espacio": {
        "elemento": { "$value": "{primitivo.espacio.2}" },
        "componente": { "$value": "{primitivo.espacio.4}" },
        "bloque": { "$value": "{primitivo.espacio.6}" },
        "seccion": { "$type": "string", "$value": "clamp(3rem, 8vw, 5rem)" }
      },

      "tipo": {
        "familiaBase": { "$value": "{primitivo.tipografia.familia.base}" },
        "familiaMono": { "$value": "{primitivo.tipografia.familia.mono}" },

        "cuerpoTamano": { "$value": "{primitivo.tipografia.tamano.300}" },
        "cuerpoInterlinea": { "$value": "{primitivo.tipografia.interlinea.comoda}" },
        "cuerpoGrandeTamano": { "$value": "{primitivo.tipografia.tamano.400}" },
        "menudoTamano": { "$value": "{primitivo.tipografia.tamano.200}" },

        "heroTamano": { "$value": "{primitivo.tipografia.tamanoFluido.hero}" },
        "titulo1Tamano": { "$value": "{primitivo.tipografia.tamanoFluido.titulo}" },
        "titulo2Tamano": { "$value": "{primitivo.tipografia.tamano.600}" },
        "titulo3Tamano": { "$value": "{primitivo.tipografia.tamano.500}" },
        "titulo4Tamano": { "$value": "{primitivo.tipografia.tamano.400}" },
        "tituloPeso": { "$value": "{primitivo.tipografia.peso.semi}" },
        "tituloInterlinea": { "$value": "{primitivo.tipografia.interlinea.titulo}" },
        "tituloEspaciado": { "$value": "{primitivo.tipografia.espaciado.titulo}" }
      },

      "radio": {
        "control": { "$value": "{primitivo.radio.md}" },
        "tarjeta": { "$value": "{primitivo.radio.lg}" },
        "pastilla": { "$value": "{primitivo.radio.completo}" }
      },

      "foco": {
        "grosor": {
          "$value": "{primitivo.borde.grueso}",
          "$description": "3 px: cumple WCAG 2.4.11 (Focus Appearance) con holgura."
        },
        "desplazamiento": { "$value": "{primitivo.borde.medio}" }
      },

      "objetivoTactil": {
        "$type": "dimension",
        "min": {
          "$value": "44px",
          "$description": "Área mínima de toque (WCAG 2.5.5 AAA / 2.5.8 AA pide 24). Usamos 44 porque el sitio se consume mucho en móvil."
        }
      },

      "movimiento": {
        "duracionRapida": { "$value": "{primitivo.movimiento.duracion.rapida}" },
        "duracionMedia": { "$value": "{primitivo.movimiento.duracion.media}" },
        "curva": { "$value": "{primitivo.movimiento.curva.salida}" }
      },

      "capa": {
        "encabezado": { "$value": "{primitivo.capa.encabezado}" },
        "menu": { "$value": "{primitivo.capa.menu}" },
        "saltar": { "$value": "{primitivo.capa.saltar}" }
      }
    },

    "claro": {
      "$description": "Tema claro. Es el tema por defecto y el que se aplica si el sistema no expresa preferencia.",
      "color": {
        "$type": "color",

        "superficieBase": { "$value": "{primitivo.color.neutro.0}" },
        "superficieSutil": { "$value": "{primitivo.color.neutro.50}" },
        "superficieHundida": { "$value": "{primitivo.color.neutro.100}" },
        "superficieElevada": { "$value": "{primitivo.color.neutro.0}" },
        "superficieMarca": { "$value": "{primitivo.color.azul.800}" },
        "superficieMarcaSutil": { "$value": "{primitivo.color.azul.50}" },

        "textoPrincipal": { "$value": "{primitivo.color.neutro.900}" },
        "textoSecundario": { "$value": "{primitivo.color.neutro.700}" },
        "textoTenue": { "$value": "{primitivo.color.neutro.600}" },
        "textoSobreMarca": { "$value": "{primitivo.color.neutro.0}" },
        "textoTenueSobreMarca": {
          "$value": "{primitivo.color.neutro.300}",
          "$description": "Texto secundario DENTRO del header/footer azul. No se puede reusar textoTenue ahí: sobre la superficie de marca se queda en 1.95:1."
        },
        "textoEnlace": { "$value": "{primitivo.color.azul.700}" },
        "textoEnlaceHover": { "$value": "{primitivo.color.azul.900}" },

        "bordeSutil": { "$value": "{primitivo.color.neutro.200}" },
        "bordeMedio": { "$value": "{primitivo.color.neutro.300}" },
        "bordeFuerte": { "$value": "{primitivo.color.neutro.500}" },
        "bordeFoco": { "$value": "{primitivo.color.azul.700}" },

        "accionPrimariaFondo": { "$value": "{primitivo.color.azul.700}" },
        "accionPrimariaFondoHover": { "$value": "{primitivo.color.azul.800}" },
        "accionPrimariaTexto": { "$value": "{primitivo.color.neutro.0}" },

        "accionSecundariaFondo": { "$value": "{primitivo.color.neutro.0}" },
        "accionSecundariaFondoHover": { "$value": "{primitivo.color.azul.50}" },
        "accionSecundariaTexto": { "$value": "{primitivo.color.azul.700}" },
        "accionSecundariaBorde": { "$value": "{primitivo.color.azul.700}" },

        "acentoFondo": { "$value": "{primitivo.color.oro.300}" },
        "acentoTexto": { "$value": "{primitivo.color.neutro.900}" },
        "acentoLinea": {
          "$value": "{primitivo.color.oro.500}",
          "$description": "Más oscuro que el oro de fondo: una línea de acento es información no textual y necesita 3:1 contra el fondo (WCAG 1.4.11). El oro.400 se queda en 2.3:1 sobre blanco."
        },

        "exitoFondo": { "$value": "{primitivo.color.exito.50}" },
        "exitoBorde": { "$value": "{primitivo.color.exito.600}" },
        "exitoTexto": { "$value": "{primitivo.color.exito.700}" },

        "alertaFondo": { "$value": "{primitivo.color.alerta.50}" },
        "alertaBorde": { "$value": "{primitivo.color.alerta.600}" },
        "alertaTexto": { "$value": "{primitivo.color.alerta.700}" },

        "errorFondo": { "$value": "{primitivo.color.error.50}" },
        "errorBorde": { "$value": "{primitivo.color.error.600}" },
        "errorTexto": { "$value": "{primitivo.color.error.600}" },

        "resaltadoFondo": { "$value": "{primitivo.color.oro.100}" },
        "resaltadoTexto": { "$value": "{primitivo.color.neutro.900}" }
      },
      "sombra": {
        "$type": "shadow",
        "tarjeta": { "$value": "0 1px 2px rgba(9, 49, 85, 0.06), 0 2px 8px rgba(9, 49, 85, 0.06)" },
        "elevada": { "$value": "0 4px 12px rgba(9, 49, 85, 0.10), 0 12px 28px rgba(9, 49, 85, 0.10)" }
      }
    },

    "oscuro": {
      "$description": "Tema oscuro. No es 'el claro invertido': los azules se aclaran para mantener contraste sobre fondo oscuro, y las superficies suben de tono al elevarse (no usan sombra, que no se ve en oscuro).",
      "color": {
        "$type": "color",

        "superficieBase": { "$value": "{primitivo.color.neutro.950}" },
        "superficieSutil": { "$value": "{primitivo.color.neutro.900}" },
        "superficieHundida": { "$value": "{primitivo.color.neutro.1000}" },
        "superficieElevada": { "$value": "{primitivo.color.neutro.800}" },
        "superficieMarca": { "$value": "{primitivo.color.azul.900}" },
        "superficieMarcaSutil": { "$value": "{primitivo.color.azul.950}" },

        "textoPrincipal": { "$value": "{primitivo.color.neutro.100}" },
        "textoSecundario": { "$value": "{primitivo.color.neutro.300}" },
        "textoTenue": { "$value": "{primitivo.color.neutro.400}" },
        "textoSobreMarca": { "$value": "{primitivo.color.neutro.0}" },
        "textoTenueSobreMarca": { "$value": "{primitivo.color.neutro.400}" },
        "textoEnlace": { "$value": "{primitivo.color.azul.300}" },
        "textoEnlaceHover": { "$value": "{primitivo.color.azul.200}" },

        "bordeSutil": { "$value": "{primitivo.color.neutro.800}" },
        "bordeMedio": { "$value": "{primitivo.color.neutro.700}" },
        "bordeFuerte": {
          "$value": "{primitivo.color.neutro.400}",
          "$description": "Un paso más claro que en el tema claro. Con neutro.500 el borde de un campo dentro de una tarjeta elevada caía a 2.90:1."
        },
        "bordeFoco": { "$value": "{primitivo.color.oro.300}" },

        "accionPrimariaFondo": { "$value": "{primitivo.color.azul.300}" },
        "accionPrimariaFondoHover": { "$value": "{primitivo.color.azul.200}" },
        "accionPrimariaTexto": { "$value": "{primitivo.color.neutro.950}" },

        "accionSecundariaFondo": { "$value": "{primitivo.color.neutro.900}" },
        "accionSecundariaFondoHover": { "$value": "{primitivo.color.neutro.800}" },
        "accionSecundariaTexto": { "$value": "{primitivo.color.azul.300}" },
        "accionSecundariaBorde": { "$value": "{primitivo.color.azul.300}" },

        "acentoFondo": { "$value": "{primitivo.color.oro.300}" },
        "acentoTexto": { "$value": "{primitivo.color.neutro.950}" },
        "acentoLinea": { "$value": "{primitivo.color.oro.300}" },

        "exitoFondo": { "$value": "{primitivo.color.exito.900}" },
        "exitoBorde": {
          "$value": "{primitivo.color.exito.300}",
          "$description": "Invertido respecto al tema claro: sobre fondo oscuro el borde tiene que ACLARARSE para conservar 3:1. Este es justo el caso que justifica tener tokens semánticos por tema."
        },
        "exitoTexto": { "$value": "{primitivo.color.exito.100}" },

        "alertaFondo": { "$value": "{primitivo.color.alerta.900}" },
        "alertaBorde": { "$value": "{primitivo.color.alerta.300}" },
        "alertaTexto": { "$value": "{primitivo.color.alerta.100}" },

        "errorFondo": { "$value": "{primitivo.color.error.900}" },
        "errorBorde": { "$value": "{primitivo.color.error.300}" },
        "errorTexto": { "$value": "{primitivo.color.error.100}" },

        "resaltadoFondo": { "$value": "{primitivo.color.oro.700}" },
        "resaltadoTexto": { "$value": "{primitivo.color.neutro.0}" }
      },
      "sombra": {
        "$type": "shadow",
        "tarjeta": { "$value": "0 1px 2px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.4)" },
        "elevada": { "$value": "0 4px 12px rgba(0, 0, 0, 0.55), 0 12px 28px rgba(0, 0, 0, 0.45)" }
      }
    }
  }
}
